<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_container"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:background="@android:color/transparent">

    <!-- Full high-DPI rendered Dragon Background Audio Card matching the in-app player -->
    <ImageView
        android:id="@+id/notif_card_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY" />

    <!-- Proportional hit-target grid mapped 1:1 to the visual buttons on the rendered card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <!-- Row 1 (0..24%): Header [BG AUDIO] | [✨ Dragon Pulse] | [↗ Video] | [✕] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/notif_hit_header_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_style_pill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_video_pill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="18"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_close_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="12"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 2 (24..57%): [Actual Video Thumbnail + Title/Codec] | [Live Playing Animation] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="33"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/notif_hit_media_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="76"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_visualizer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="24"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 3 (57..72%): Capsule Timeline Scrubber with 5 direct seek zones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/notif_hit_time_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_seek_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_seek_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_seek_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_seek_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_seek_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_time_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 4 (72..100%): Transport Controls [|◄] | [↺ 10] | [|| / ▶] | [↻ 10] | [►|] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="28"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/notif_hit_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_rewind"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="20"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/notif_hit_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
